{
  "name": "mortgage-calculator-v2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/lib",
    "test:watch": "vitest src/lib",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run build -- --base=/mortgage-calculator/",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run typecheck && storybook build"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "^8.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "storybook": "^8.3.5",
    "typescript": "^7.0.2",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
